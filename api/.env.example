# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Firebase (Admin SDK) ───────────────────────────────────────────────────────
# Paste the entire service account JSON as a single-line string
FIREBASE_PROJECT_ID=barpass-app
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"barpass-app","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@barpass-app.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ── Stripe ─────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Redis (idempotency layer) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── PassKit (Apple Wallet pass generation) ─────────────────────────────────────
PASSKIT_API_KEY=...
PASSKIT_TEMPLATE_NAME=barpass-wallet

# ── Internal ────────────────────────────────────────────────────────────────────
INTERNAL_SECRET=change_me_in_production
BP_SECRET=BP_S3CR3T_2024_M1AM1
