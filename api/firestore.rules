rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isStaffOrAbove() {
      return isSignedIn() && request.auth.token.role in ['staff', 'manager', 'admin'];
    }

    function isManagerOrAbove() {
      return isSignedIn() && request.auth.token.role in ['manager', 'admin'];
    }


    // ── Wallets ───────────────────────────────────────────────────────────────
    // Only the wallet owner reads their balance; writes are server-only (Admin SDK).
    match /wallets/{uid} {
      allow read:  if isOwner(uid);
      allow write: if false; // Admin SDK only

      match /transactions/{txId} {
        allow read:  if isOwner(uid);
        allow write: if false; // Admin SDK only
      }
    }


    // ── Orders (POS transactions) ─────────────────────────────────────────────
    // Staff can create and read. Only managers can read across all vendors.
    match /orders/{orderId} {
      allow read:   if isStaffOrAbove() || isOwner(resource.data.customer_id);
      allow create: if isStaffOrAbove()
                    && request.resource.data.vendor_id is string
                    && request.resource.data.items is list
                    && request.resource.data.total is number
                    && request.resource.data.total > 0;
      allow update: if isManagerOrAbove(); // refund status update
      allow delete: if false;
    }


    // ── Refunds ───────────────────────────────────────────────────────────────
    match /refunds/{refundId} {
      allow read:   if isStaffOrAbove();
      allow create: if isManagerOrAbove();
      allow update, delete: if false;
    }


    // ── Vendor stats ──────────────────────────────────────────────────────────
    match /vendorStats/{docId} {
      allow read:  if isStaffOrAbove();
      allow write: if false; // Admin SDK only
    }


    // ── Venues (public read, admin write) ─────────────────────────────────────
    match /venues/{venueId} {
      allow read: if true;
      allow write: if hasRole('admin');

      match /heatmap/{slotId} {
        allow read: if true;
        allow write: if false; // Cloud Function only
      }
    }


    // ── Users (profile data) ──────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isOwner(uid) || isStaffOrAbove();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
                    // Prevent self-elevating role
                    && !('role' in request.resource.data);
      allow delete: if false;
    }


    // ── Push tokens ───────────────────────────────────────────────────────────
    match /pushTokens/{uid} {
      allow read:  if isOwner(uid);
      allow write: if isOwner(uid);
    }


    // ── Health check (server-side only) ───────────────────────────────────────
    match /_health/{doc} {
      allow read, write: if false;
    }


    // ── Default deny ─────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
