# ── Supabase ────────────────────────────────────────────────
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-side only — bypasses RLS, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe ──────────────────────────────────────────────────
# Server-side only. Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=sk_live_or_sk_test_...

# ── Gemini (AI Concierge) ───────────────────────────────────
# Server-side only — never exposed to the client.
GEMINI_API_KEY=your-gemini-api-key

# ── Venue door-staff validation ─────────────────────────────
# Shared PIN staff enter once to unlock the /validate scanner page.
VENUE_VALIDATION_SECRET=your-venue-validation-secret

# Safety groups: APNs push (server-only, never NEXT_PUBLIC_). Create a key in
# Apple Developer -> Keys -> "Apple Push Notifications service (APNs)". Optional:
# without these, /api/safety/notify answers 503 and searches still save.
APNS_KEY_ID=
APNS_TEAM_ID=
# The .p8 file contents; newlines may be written as 

APNS_PRIVATE_KEY=
# Defaults to com.sebastian.barpass
APNS_BUNDLE_ID=
